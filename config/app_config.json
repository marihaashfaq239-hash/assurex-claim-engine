{
  "app": {
    "name": "AssureX Claim Engine",
    "version": "1.0.0",
    "description": "AI-powered warranty claim management system"
  },
  "ai_thresholds": {
    "confidence_threshold_min": 0.70,
    "strong_match_max_diff": 5.0,
    "acceptable_match_max_diff": 15.0,
    "weak_match_max_diff": 25.0,
    "auto_approve_min_confidence": 0.92,
    "auto_reject_min_confidence": 0.92,
    "manual_review_confidence_below": 0.70
  },
  "warranty": {
    "expiry_alert_days": 30,
    "claim_reporting_period_days": 14,
    "max_claims_per_product": 3
  },
  "document": {
    "allowed_types": ["pdf", "jpg", "jpeg", "png"],
    "max_size_mb": 5,
    "required_for_claim": ["purchase_receipt", "product_image", "fault_evidence"]
  },
  "model_consistency": {
    "strong_match": {"max_diff": 5, "label": "Strong Match", "color": "success"},
    "acceptable_match": {"max_diff": 15, "label": "Acceptable Match", "color": "info"},
    "weak_match": {"max_diff": 25, "label": "Weak Match", "color": "warning"},
    "model_disagreement": {"label": "Model Disagreement", "color": "danger"},
    "uncertain_result": {"label": "Uncertain Result", "color": "secondary"}
  },
  "claim_status_flow": [
    "Draft",
    "Submitted",
    "Under Evaluation",
    "Additional Information Required",
    "Manual Review",
    "Approved",
    "Rejected",
    "Closed"
  ]
}
